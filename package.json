{
  "name": "mcp-http-proxy",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server that provides HTTP request proxying with CRUD operations for AI applications",
  "main": "dist/index.js",
  "bin": {
    "mcp-http-proxy": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/akhshyganesh/MCP-CURL.git"
  },
  "homepage": "https://github.com/akhshyganesh/MCP-CURL",
  "bugs": {
    "url": "https://github.com/akhshyganesh/MCP-CURL/issues"
  },
  "keywords": [
    "mcp", 
    "model-context-protocol", 
    "crud", 
    "proxy", 
    "curl", 
    "http", 
    "api", 
    "typescript",
    "ai",
    "cli",
    "server"
  ],
  "author": "Akhshy Ganesh <akhshy.balakannan@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.76"
  }
}
